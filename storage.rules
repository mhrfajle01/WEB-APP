rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /blog-covers/{allPaths=**} {
      // Allow public to read images
      allow read;
      
      // Allow only admin to upload/delete images
      allow write: if request.auth != null && request.auth.token.email == 'mhfajle136@gmail.com';
    }
  }
}
