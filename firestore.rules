rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users Collection Rules
    match /users/{userId} {
      // Allow users to read/write their own document
      allow read, write: if request.auth != null && (request.auth.uid == userId || request.auth.token.email == 'mhfajle136@gmail.com');
      // Allow admin to read all
      allow list: if request.auth != null && request.auth.token.email == 'mhfajle136@gmail.com';
    }

    // Post Collection Rules
    match /posts/{postId} {
      allow read: if resource.data.status == 'published';
      allow read, write: if request.auth != null && request.auth.token.email == 'mhfajle136@gmail.com';
    }
    
    // Default fallback
    match /{document=**} {
      allow read: if true; 
      allow write: if request.auth != null && request.auth.token.email == 'mhfajle136@gmail.com';
    }
  }
}
